<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PMQ.Identity</PackageId>
    <Version>1.1.2</Version>
    <Product>PMQ.Identity</Product>
    <Description>Provider-agnostic identity module for authentication and authorization. Supports External (OIDC/JWT) and Local (self-issued JWT) modes.</Description>
    <PackageProjectUrl>https://github.com/PabloMickaelQuevedo/PMQ.Identity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PabloMickaelQuevedo/PMQ.Identity.git</RepositoryUrl>
    <PackageTags>identity;authentication;authorization;jwt;oidc</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <!--
    Compara a API deste build com a do pacote já publicado, baixado do NuGet, e por
    target framework. Remover membro público reprova o pack com CP0002.

    O baseline é a última versão publicada e sobe junto com o release. Quebra
    intencional se registra com -p:ApiCompatGenerateSuppressionFile=true, commitando
    o arquivo gerado — a decisão fica explícita e revisável em vez de silenciosa.

    Compara assinatura, não piso de dependência: subir o grupo net8.0 para um pacote
    10.x continua sendo trabalho do guard em Directory.Build.targets.
  -->
  <PropertyGroup Label="Compatibilidade">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PMQ.Identity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
